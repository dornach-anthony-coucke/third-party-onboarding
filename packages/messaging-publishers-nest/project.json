{
  "name": "messaging-publishers-nest",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/messaging-publishers-nest/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/messaging-publishers-nest/dist",
        "main": "packages/messaging-publishers-nest/src/index.ts",
        "tsConfig": "packages/messaging-publishers-nest/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/messaging-publishers-nest"
      }
    }
  },
  "tags": ["type:library", "scope:messaging"]
}
