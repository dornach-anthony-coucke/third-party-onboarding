{
  "name": "drizzle-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/drizzle-core/src",
  "projectType": "library",
  "tags": ["type:package", "scope:database"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --watch",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "generate-migrations": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "pnpm run generate-migrations",
        "cwd": "{projectRoot}"
      }
    },
    "run-migrations": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "pnpm run run-migrations",
        "cwd": "{projectRoot}"
      }
    }
  }
}
