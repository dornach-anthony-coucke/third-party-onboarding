{
  "name": "third-party-onboarding-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Third-party onboarding monorepo with NestJS API and reusable packages",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "test": "pnpm -r --filter='./packages/*' --filter='./apps/*' run test",
    "lint": "pnpm -r --filter='./packages/*' --filter='./apps/*' run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1"
}
