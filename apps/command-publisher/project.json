{
  "name": "command-publisher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/command-publisher/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:command-publisher"
  ],
  "implicitDependencies": [
    "drizzle-core",
    "database-nest-module",
    "messaging-aws",
    "messaging-core"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsup",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "database-nest-module:build",
        "drizzle-core:build",
        "messaging-aws:build",
        "messaging-core:build"
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --watch --onSuccess \"node dist/main.js\"",
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/main.js",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest",
        "cwd": "{projectRoot}"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "command": "vitest run --coverage",
        "cwd": "{projectRoot}"
      }
    }
  }
}